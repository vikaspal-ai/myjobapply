{
  "name": "myjobapply",
  "version": "0.1.0",
  "description": "Job Hunt Platform - Single-user $0 hybrid job discovery, matching, and application automation",
  "type": "module",
  "main": "dist/index.js",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "tsc",
    "build:frontend": "npm run build --prefix frontend",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:server": "tsx watch src/api/server.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "demo": "tsx scripts/demo.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "db:clean-test": "tsx -e \"import { sql } from './src/db/index.js'; await sql\\`DELETE FROM profile.candidate_profiles WHERE email NOT LIKE '%@demo.jobsapply'\\`; console.log('Cleaned test candidates'); await sql.end();\"",
    "server": "tsx src/api/server.ts"
  },
  "keywords": [
    "job-hunt",
    "automation",
    "supabase",
    "playwright"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@supabase/server": "^1.0.1",
    "@supabase/supabase-js": "^2.49.1",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.5",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
